{
  "name": "ridgeway",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "**/react-native",
      "**/react-native/**"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@ridgeway/mobile-app",
    "dev:web": "turbo run dev --filter=@ridgeway/web-app",
    "dev:apps": "turbo run dev --filter=@ridgeway/mobile-app --filter=@ridgeway/web-app",
    "dev:backend": "convex dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "test": "turbo run test",
    "test:mobile": "turbo run test --filter=@ridgeway/mobile-app",
    "test:web": "turbo run test --filter=@ridgeway/web-app",
    "test:shared": "turbo run test --filter=shared",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.10.11",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "convex": "^1.45.0"
  },
  "resolutions": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@react-native/jest-preset": "0.86.3"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "yarn": ">=1.22.0",
    "node": ">=22.13.0"
  }
}
