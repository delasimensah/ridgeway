# Supabase Configuration
# Copy this file to .env.local and fill in your values
# Get these values from 'yarn supabase:start' output

# Supabase URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 

# Supabase Publishable Key — https://supabase.com/docs/guides/api/api-keys
# Hosted: Dashboard → API Keys → Publishable. Local: paste JWT from CLI "anon key" line.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx