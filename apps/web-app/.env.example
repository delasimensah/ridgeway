# Used by the Next.js app to talk to Convex.

NEXT_PUBLIC_CONVEX_URL=

# Public demo sign-in. The three buttons show when the lock is on and each password is set.
# Restart the website after changing these. The save lock itself is RIDGEWAY_DEMO_LOCK on Convex.
# NEXT_PUBLIC_DEMO_LOCK=on
# NEXT_PUBLIC_DEMO_STAFF_PASSWORD=
# NEXT_PUBLIC_DEMO_OWNER_PASSWORD=
# NEXT_PUBLIC_DEMO_TENANT_PASSWORD=
