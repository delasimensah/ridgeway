# Supabase Configuration
# Copy this file to .env.local and fill in your values
# Get these values from 'yarn supabase:start' output

# Supabase URL
# For iOS Simulator and physical devices: http://127.0.0.1:54321
# For Android Emulator: http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 

# Supabase Publishable Key (see https://supabase.com/docs/guides/api/api-keys)
# Hosted: Dashboard → Settings → API Keys → Publishable (`sb_publishable_...`).
# Local CLI: use the JWT shown as “anon key” until you use a hosted publishable key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
