# Written by `npx convex dev` / `yarn dev:backend` at the repo root.
# CONVEX_DEPLOYMENT=
# CONVEX_URL=
# CONVEX_SITE_URL=
#
# Convex Auth keys (JWT_PRIVATE_KEY, JWKS, SITE_URL) are set on the Convex
# deployment, not in this file. See docs/convex-auth-env.md.

# Web and mobile use their own .env.local files with different names for the same URL:
#   apps/web-app/.env.local     → NEXT_PUBLIC_CONVEX_URL=
#   apps/mobile-app/.env.local  → EXPO_PUBLIC_CONVEX_URL=
